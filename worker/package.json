{
  "name": "@mythrart/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/worker/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "cd .. && npm run prisma:generate",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && node -e \"const fs=require('node:fs'); fs.rmSync('dist/worker/generated/prisma',{recursive:true,force:true}); fs.mkdirSync('dist/worker/generated',{recursive:true}); fs.cpSync('generated/prisma','dist/worker/generated/prisma',{recursive:true});\"",
    "start": "node dist/worker/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/html": "^3.30.5",
    "bullmq": "^5.58.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.8.1",
    "pino": "^10.0.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^20.19.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
